# Contact form — src/app/api/contact/route.ts
#
# Without RESEND_API_KEY the form still works: it reports "not connected yet"
# and hands the visitor their own mail client with the message pre-written, so
# nothing is ever lost. Set the key to have messages delivered directly.
#
# To turn it on:
#   1. Create a free account at https://resend.com (free tier: 100 emails/day)
#   2. Create an API key
#   3. Add it in Vercel under Settings → Environment Variables, then redeploy
#
# Keep the real key out of the repo — set it in Vercel, or in a local
# .env.local, which is gitignored.

RESEND_API_KEY=

# Optional. Defaults to the address in src/lib/site.ts.
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's shared onboarding sender, which needs no
# domain verification and can deliver to the account owner — enough for a
# personal contact form. Set a verified domain sender here if you add one.
CONTACT_FROM_EMAIL=
